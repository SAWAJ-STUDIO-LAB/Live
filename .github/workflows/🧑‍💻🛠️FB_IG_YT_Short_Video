name: 🧑‍💻🛠️FB_IG_YT_Short_Video

on:
  workflow_dispatch:
    inputs:
      mode:
        description: 'Mode'
        required: true
        type: choice
        options: [online_test, offline_test]
        default: online_test

permissions:
  contents: write

jobs:
  short:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.TOKEN_GITHUB || secrets.GITHUB_TOKEN }}

      - name: Install deps
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y ffmpeg fonts-noto fonts-noto-color-emoji
          pip install requests urllib3 Pillow mutagen edge-tts gTTS \
                      google-auth google-auth-oauthlib google-api-python-client

      - name: Build and Run
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          HADITH_API_URL: ${{ secrets.HADITH_API_URL }}
          QURAN_API_URL: ${{ secrets.QURAN_API_URL }}
          OPENROUTER_API_KEY_AI: ${{ secrets.OPENROUTER_API_KEY_AI }}
          GROQ_API_KEY_AI: ${{ secrets.GROQ_API_KEY_AI }}
          GEMINI_API_KEY_AI: ${{ secrets.GEMINI_API_KEY_AI }}
          MISTRAL_API_KEY_AI: ${{ secrets.MISTRAL_API_KEY_AI }}
          COHERE_API_KEY_AI: ${{ secrets.COHERE_API_KEY_AI }}
          HUGGINGFACE_API_KEY_AI: ${{ secrets.HUGGINGFACE_API_KEY_AI }}
          CEREBRAS_API_KEY_AI: ${{ secrets.CEREBRAS_API_KEY_AI }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          POLLINATIONS_API_URL: ${{ secrets.POLLINATIONS_API_URL }}
          SCALEWAY_API_URL: ${{ secrets.SCALEWAY_API_URL }}
          JINA_API_KEY: ${{ secrets.JINA_API_KEY }}
          TAVILY_API_KEY_AI: ${{ secrets.TAVILY_API_KEY_AI }}
          LIBRETRANSLATE_URL: ${{ secrets.LIBRETRANSLATE_URL }}
          DEEPLX_URL: ${{ secrets.DEEPLX_URL }}
          SARVAM_API_KEY: ${{ secrets.SARVAM_API_KEY }}
          ELEVENLABS_API_KEY: ${{ secrets.ELEVENLABS_API_KEY }}
          VOICECAFE_API_URL: ${{ secrets.VOICECAFE_API_URL }}
          DEEPGRAM_API_KEY: ${{ secrets.DEEPGRAM_API_KEY }}
          FREESOUND_API_KEY: ${{ secrets.FREESOUND_API_KEY }}
          FREESOUND_MUSIC_URL: ${{ secrets.FREESOUND_MUSIC_URL }}
          PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
          JAMENDO_CLIENT_ID: ${{ secrets.JAMENDO_CLIENT_ID }}
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
          GOOGLE_DRIVE_CLIENT_ID: ${{ secrets.GOOGLE_DRIVE_CLIENT_ID }}
          GOOGLE_DRIVE_CLIENT_SECRET: ${{ secrets.GOOGLE_DRIVE_CLIENT_SECRET }}
          GOOGLE_DRIVE_REFRESH_TOKEN: ${{ secrets.GOOGLE_DRIVE_REFRESH_TOKEN }}
          GDRIVE_SHORT_VIDEO_FOLDER_ID: ${{ secrets.GDRIVE_SHORT_VIDEO_FOLDER_ID }}
          FACEBOOK_PAGE_ID: ${{ secrets.FACEBOOK_PAGE_ID }}
          FB_PAGE_ACCESS_TOKEN: ${{ secrets.FB_PAGE_ACCESS_TOKEN }}
          INSTAGRAM_BUSINESS_ACCOUNT_ID: ${{ secrets.INSTAGRAM_BUSINESS_ACCOUNT_ID }}
          YOUTUBE_CLIENT_ID: ${{ secrets.YOUTUBE_CLIENT_ID }}
          YOUTUBE_CLIENT_SECRET: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
          YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
          DAILY_HADEES_YT_PLAYLIST_ID: ${{ secrets.DAILY_HADEES_YT_PLAYLIST_ID }}
          UPLOAD_MODE: ${{ inputs.mode == 'online_test' && 'online' || 'offline' }}
          UPLOAD_CONFIRMED: ${{ inputs.mode == 'online_test' && 'true' || 'false' }}
        run: |
          mkdir -p _work && cd _work

          cat > short.py << 'PYEOF'
          # [same as story.py but: hadith 150-400 words, intro/outro 1.5s,
          #  TTS faster, + YouTube upload, + trending hook, + hashtags]
          # To keep answer compact, use same structure as story.py with these edits:
          # - fetch_hadith(sess, 150, 400)
          # - intro/outro = 1.5
          # - TTS edge rate: -8%
          # - Master tempo 0.95
          # - Add yt_upload() function
          # - Final: fb_upload + ig_upload + yt_upload
          import os, time, subprocess, shutil, random, math, base64, traceback
          from datetime import datetime
          import requests
          from requests.adapters import HTTPAdapter
          from urllib3.util.retry import Retry
          from PIL import Image, ImageDraw, ImageFont
          from mutagen.mp3 import MP3

          C = {
            "TG":os.environ.get("TELEGRAM_BOT_TOKEN","").strip(),
            "TG_CHAT":os.environ.get("TELEGRAM_CHAT_ID","").strip(),
            "HADITH":os.environ.get("HADITH_API_URL","").strip(),
            "QURAN":os.environ.get("QURAN_API_URL","").strip(),
            "OR":os.environ.get("OPENROUTER_API_KEY_AI","").strip(),
            "GRQ":os.environ.get("GROQ_API_KEY_AI","").strip(),
            "GEM":os.environ.get("GEMINI_API_KEY_AI","").strip(),
            "MIS":os.environ.get("MISTRAL_API_KEY_AI","").strip(),
            "COH":os.environ.get("COHERE_API_KEY_AI","").strip(),
            "HF":os.environ.get("HUGGINGFACE_API_KEY_AI","").strip(),
            "CER":os.environ.get("CEREBRAS_API_KEY_AI","").strip(),
            "DS":os.environ.get("DEEPSEEK_API_KEY","").strip(),
            "POL":os.environ.get("POLLINATIONS_API_URL","").strip(),
            "SCW":os.environ.get("SCALEWAY_API_URL","").strip(),
            "JINA":os.environ.get("JINA_API_KEY","").strip(),
            "TAV":os.environ.get("TAVILY_API_KEY_AI","").strip(),
            "LIB":os.environ.get("LIBRETRANSLATE_URL","").strip(),
            "DXL":os.environ.get("DEEPLX_URL","").strip(),
            "SAR":os.environ.get("SARVAM_API_KEY","").strip(),
            "11L":os.environ.get("ELEVENLABS_API_KEY","").strip(),
            "VCF":os.environ.get("VOICECAFE_API_URL","").strip(),
            "DPG":os.environ.get("DEEPGRAM_API_KEY","").strip(),
            "FS":os.environ.get("FREESOUND_API_KEY","").strip(),
            "FSU":os.environ.get("FREESOUND_MUSIC_URL","").strip(),
            "PX":os.environ.get("PIXABAY_API_KEY","").strip(),
            "JAM":os.environ.get("JAMENDO_CLIENT_ID","").strip(),
            "PEX":os.environ.get("PEXELS_API_KEY","").strip(),
            "GDCID":os.environ.get("GOOGLE_DRIVE_CLIENT_ID","").strip(),
            "GDCS":os.environ.get("GOOGLE_DRIVE_CLIENT_SECRET","").strip(),
            "GDRT":os.environ.get("GOOGLE_DRIVE_REFRESH_TOKEN","").strip(),
            "GDF":os.environ.get("GDRIVE_SHORT_VIDEO_FOLDER_ID","").strip(),
            "FBPID":os.environ.get("FACEBOOK_PAGE_ID","").strip(),
            "FBTOK":os.environ.get("FB_PAGE_ACCESS_TOKEN","").strip(),
            "IGID":os.environ.get("INSTAGRAM_BUSINESS_ACCOUNT_ID","").strip(),
            "YTCID":os.environ.get("YOUTUBE_CLIENT_ID","").strip(),
            "YTCS":os.environ.get("YOUTUBE_CLIENT_SECRET","").strip(),
            "YTRT":os.environ.get("YOUTUBE_REFRESH_TOKEN","").strip(),
            "YTPL":os.environ.get("DAILY_HADEES_YT_PLAYLIST_ID","").strip(),
            "MODE":os.environ.get("UPLOAD_MODE","online").strip().lower(),
            "CONF":str(os.environ.get("UPLOAD_CONFIRMED","true")).lower()=="true",
          }
          SOCIAL = C["MODE"]=="online" and C["CONF"]

          LOGS=[]
          def log(m,lv="INFO"):
              s=f"[{datetime.now():%H:%M:%S}] [{lv}] {m}"; print(s,flush=True); LOGS.append(s)
          def tg(m):
              if not (C["TG"] and C["TG_CHAT"]): return
              try: requests.post(f"https://api.telegram.org/bot{C['TG']}/sendMessage",
                  json={"chat_id":C["TG_CHAT"],"text":m[:3900],"disable_web_page_preview":True,"disable_notification":True},timeout=15)
              except: pass
          def report():
              t="\n".join(LOGS)
              for i in range(0,len(t),3800): tg(t[i:i+3800])
          def new_session():
              s=requests.Session()
              r=Retry(total=5,backoff_factor=1.5,status_forcelist=[429,500,502,503,504])
              s.mount("https://",HTTPAdapter(max_retries=r))
              s.headers.update({"User-Agent":"SawajBot/5.0"}); return s
          def dl(sess,url,path,mn=12000,rt=2):
              for _ in range(rt):
                  try:
                      r=sess.get(url,timeout=60,stream=True)
                      if r.status_code!=200: continue
                      w=0
                      with open(path,"wb") as f:
                          for c in r.iter_content(65536):
                              if not c: continue
                              w+=len(c)
                              if w>200*1024*1024: return False
                              f.write(c)
                      if w>mn: return True
                  except: pass
              return False
          def runc(cmd,t=1800):
              log("CMD: "+cmd[:100])
              subprocess.run(cmd,shell=True,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=t)

          BOOKS=[("eng-bukhari","ara-bukhari","Sahih al-Bukhari",7000),
                 ("eng-muslim","ara-muslim","Sahih Muslim",5000)]
          def fetch_hadith(sess,mn=150,mx=400):
              bases=[C["HADITH"].rstrip("/")] if C["HADITH"] else []
              bases.append("https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1")
              for _ in range(40):
                  e,a,n,m=random.choice(BOOKS); num=random.randint(1,m)
                  for b in bases:
                      try:
                          r=sess.get(f"{b}/editions/{e}/{num}.json",timeout=15)
                          if r.status_code!=200: continue
                          hh=r.json().get("hadiths",[])
                          if not hh: continue
                          txt=hh[0].get("text","").strip()
                          if len(txt)<30: continue
                          if not (mn<=len(txt.split())<=mx): continue
                          ar=""
                          try:
                              ar_r=sess.get(f"{b}/editions/{a}/{num}.json",timeout=10)
                              if ar_r.status_code==200:
                                  ad=ar_r.json().get("hadiths",[])
                                  if ad: ar=ad[0].get("text","").strip()
                          except: pass
                          return {"collection":n,"number":str(hh[0].get("hadithnumber") or num),
                                  "english":txt,"arabic":ar,"book":n}
                      except: continue
              return {"collection":"Sahih al-Bukhari","number":"1",
                      "english":"The reward of deeds depends upon the intentions.",
                      "arabic":"Innamal aamalu bin niyyat","book":"Sahih al-Bukhari"}
          def fetch_quran(sess):
              if not C["QURAN"]: return ""
              try:
                  n=random.randint(1,114)
                  r=sess.get(f"{C['QURAN'].rstrip('/')}/v1/surah/{n}",timeout=15)
                  if r.status_code==200:
                      d=r.json().get("data",{}); ay=d.get("ayahs",[])
                      if ay: return ay[0].get("text","")
              except: pass
              return ""

          def ai_call(sess,prompt,mt=500):
              provs=[]
              def _oai(url,key,model):
                  def _f():
                      r=sess.post(url,headers={"Authorization":f"Bearer {key}","Content-Type":"application/json"},
                          json={"model":model,"messages":[{"role":"user","content":prompt}],
                                "temperature":0.7,"max_tokens":mt},timeout=60)
                      if r.status_code==200: return r.json()["choices"][0]["message"]["content"].strip()
                      raise Exception(f"HTTP {r.status_code}")
                  return _f
              def _gem():
                  u=f"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={C['GEM']}"
                  r=sess.post(u,json={"contents":[{"parts":[{"text":prompt}]}]},timeout=60)
                  if r.status_code==200: return r.json()["candidates"][0]["content"]["parts"][0]["text"].strip()
                  raise Exception(f"HTTP {r.status_code}")
              def _coh():
                  r=sess.post("https://api.cohere.com/v1/chat",
                      headers={"Authorization":f"Bearer {C['COH']}","Content-Type":"application/json"},
                      json={"model":"command-r-plus","message":prompt},timeout=60)
                  if r.status_code==200: return r.json().get("text","").strip()
                  raise Exception(f"HTTP {r.status_code}")
              def _hf():
                  r=sess.post("https://api-inference.huggingface.co/models/meta-llama/Meta-Llama-3-8B-Instruct",
                      headers={"Authorization":f"Bearer {C['HF']}","Content-Type":"application/json"},
                      json={"inputs":prompt,"parameters":{"max_new_tokens":mt,"temperature":0.7,"return_full_text":False}},timeout=90)
                  if r.status_code==200:
                      d=r.json()
                      if isinstance(d,list) and d: return d[0].get("generated_text","").strip()
                      if isinstance(d,dict): return d.get("generated_text","").strip()
                  raise Exception(f"HTTP {r.status_code}")
              def _cer():
                  r=sess.post("https://api.cerebras.ai/v1/chat/completions",
                      headers={"Authorization":f"Bearer {C['CER']}","Content-Type":"application/json"},
                      json={"model":"llama3.1-70b","messages":[{"role":"user","content":prompt}],"max_tokens":mt},timeout=60)
                  if r.status_code==200: return r.json()["choices"][0]["message"]["content"].strip()
                  raise Exception(f"HTTP {r.status_code}")
              def _ds():
                  r=sess.post("https://api.deepseek.com/chat/completions",
                      headers={"Authorization":f"Bearer {C['DS']}","Content-Type":"application/json"},
                      json={"model":"deepseek-chat","messages":[{"role":"user","content":prompt}],"max_tokens":mt},timeout=60)
                  if r.status_code==200: return r.json()["choices"][0]["message"]["content"].strip()
                  raise Exception(f"HTTP {r.status_code}")
              def _pol():
                  b=C["POL"].rstrip("/")
                  r=sess.post(f"{b}/openai",headers={"Content-Type":"application/json"},
                      json={"model":"openai","messages":[{"role":"user","content":prompt}]},timeout=60)
                  if r.status_code==200: return r.json()["choices"][0]["message"]["content"].strip()
                  raise Exception(f"HTTP {r.status_code}")
              if C["OR"]: provs.append(("OR",_oai("https://openrouter.ai/api/v1/chat/completions",C["OR"],"openai/gpt-4o-mini")))
              if C["GRQ"]: provs.append(("Groq",_oai("https://api.groq.com/openai/v1/chat/completions",C["GRQ"],"llama-3.3-70b-versatile")))
              if C["GEM"]: provs.append(("Gemini",_gem))
              if C["MIS"]: provs.append(("Mistral",_oai("https://api.mistral.ai/v1/chat/completions",C["MIS"],"mistral-small-latest")))
              if C["COH"]: provs.append(("Cohere",_coh))
              if C["HF"]: provs.append(("HF",_hf))
              if C["CER"]: provs.append(("Cerebras",_cer))
              if C["DS"]: provs.append(("DeepSeek",_ds))
              if C["POL"]: provs.append(("Pollinations",_pol))
              for name,fn in provs:
                  try:
                      out=fn()
                      if out: log(f"AI OK: {name} ({len(out)}c)"); return out
                  except Exception as e: log(f"AI FAIL {name}: {str(e)[:70]}","WARN")
              return ""

          def translate(sess,text):
              if C["LIB"]:
                  try:
                      r=sess.post(f"{C['LIB'].rstrip('/')}/translate",
                          json={"q":text,"source":"en","target":"hi","format":"text"},timeout=30)
                      if r.status_code==200:
                          t=r.json().get("translatedText","")
                          if t: log("Trans OK: Libre"); return t
                  except Exception as e: log(f"Libre: {str(e)[:70]}","WARN")
              if C["DXL"]:
                  try:
                      r=sess.post(f"{C['DXL'].rstrip('/')}/translate",
                          json={"text":text,"source_lang":"EN","target_lang":"HI"},timeout=30)
                      if r.status_code==200:
                          t=r.json().get("data","")
                          if t: log("Trans OK: DeepLX"); return t
                  except Exception as e: log(f"DeepLX: {str(e)[:70]}","WARN")
              return ""

          def tts(sess,text,out,lang="hi"):
              if C["SAR"]:
                  try:
                      r=sess.post("https://api.sarvam.ai/text-to-speech",
                          headers={"api-subscription-key":C["SAR"],"Content-Type":"application/json"},
                          json={"inputs":[text[:450]],"target_language_code":f"{lang}-IN",
                                "speaker":"meera","pitch":0,"pace":0.95,"loudness":1.2,
                                "speech_sample_rate":22050,"enable_preprocessing":True,"model":"bulbul:v1"},timeout=120)
                      if r.status_code==200:
                          a=r.json().get("audios",[])
                          if a:
                              with open(out,"wb") as f: f.write(base64.b64decode(a[0]))
                              log("TTS OK: Sarvam"); return True
                  except Exception as e: log(f"Sar: {str(e)[:70]}","WARN")
              if C["11L"]:
                  try:
                      r=sess.post("https://api.elevenlabs.io/v1/text-to-speech/pNInz6obpgDQGcFmaJgB",
                          headers={"Accept":"audio/mpeg","Content-Type":"application/json","xi-api-key":C["11L"]},
                          json={"text":text,"model_id":"eleven_multilingual_v2",
                                "voice_settings":{"stability":0.5,"similarity_boost":0.85}},timeout=180)
                      if r.status_code==200 and len(r.content)>5000:
                          with open(out,"wb") as f: f.write(r.content)
                          log("TTS OK: 11Labs"); return True
                  except Exception as e: log(f"11L: {str(e)[:70]}","WARN")
              if C["VCF"]:
                  try:
                      r=sess.post(f"{C['VCF'].rstrip('/')}/api/tts",
                          json={"text":text[:1000],"language":lang,"voice":"default","format":"mp3"},timeout=120)
                      if r.status_code==200 and len(r.content)>5000:
                          with open(out,"wb") as f: f.write(r.content)
                          log("TTS OK: VoiceCafe"); return True
                  except Exception as e: log(f"VCF: {str(e)[:70]}","WARN")
              if C["DPG"]:
                  try:
                      r=sess.post("https://api.deepgram.com/v1/speak?model=aura-asteria-en",
                          headers={"Authorization":f"Token {C['DPG']}","Content-Type":"application/json"},
                          json={"text":text[:1900]},timeout=120)
                      if r.status_code==200 and len(r.content)>5000:
                          with open(out,"wb") as f: f.write(r.content)
                          log("TTS OK: Deepgram"); return True
                  except Exception as e: log(f"DPG: {str(e)[:70]}","WARN")
              try:
                  voices={"hi":"hi-IN-MadhurNeural","ar":"ar-SA-HamedNeural","en":"en-US-ChristopherNeural"}
                  v=voices.get(lang,voices["hi"]); txt=out+".txt"
                  with open(txt,"w",encoding="utf-8") as f: f.write(text)
                  cmd=f'edge-tts --file "{txt}" --write-media "{out}" --voice {v} --rate=-8% --pitch=-3Hz --volume=+8%'
                  subprocess.run(cmd,shell=True,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=300)
                  os.remove(txt)
                  if os.path.exists(out) and os.path.getsize(out)>1000:
                      log("TTS OK: Edge"); return True
              except Exception as e: log(f"Edge: {str(e)[:70]}","WARN")
              return False

          def get_music(sess,out,dur=30):
              if C["FS"]:
                  try:
                      r=sess.get("https://freesound.org/apiv2/search/text/",
                          params={"query":"ambient","token":C["FS"],"fields":"id,previews",
                                  "filter":"duration:[20 TO 120]","page_size":5},timeout=20)
                      if r.status_code==200:
                          for it in r.json().get("results",[]):
                              u=it.get("previews",{}).get("preview-hq-mp3")
                              if not u: continue
                              a=sess.get(u,timeout=60)
                              if a.status_code==200 and len(a.content)>20000:
                                  with open(out,"wb") as f: f.write(a.content)
                                  log("Music: Freesound"); return True
                  except Exception as e: log(f"FS: {str(e)[:70]}","WARN")
              if C["FSU"]:
                  try:
                      r=sess.get(C["FSU"],timeout=60)
                      if r.status_code==200 and len(r.content)>20000:
                          with open(out,"wb") as f: f.write(r.content)
                          log("Music: FSU"); return True
                  except: pass
              if C["JAM"]:
                  try:
                      r=sess.get("https://api.jamendo.com/v3.0/tracks/",
                          params={"client_id":C["JAM"],"format":"json","limit":5,"tags":"ambient"},timeout=20)
                      if r.status_code==200:
                          for t in r.json().get("results",[]):
                              u=t.get("audio")
                              if not u: continue
                              a=sess.get(u,timeout=60)
                              if a.status_code==200 and len(a.content)>20000:
                                  with open(out,"wb") as f: f.write(a.content)
                                  log("Music: Jamendo"); return True
                  except: pass
              if C["PX"]:
                  try:
                      r=sess.get("https://pixabay.com/api/",
                          params={"key":C["PX"],"q":"ambient","category":"music","per_page":5},timeout=20)
                      if r.status_code==200:
                          for h in r.json().get("hits",[]):
                              u=h.get("audio")
                              if not u: continue
                              a=sess.get(u,timeout=60)
                              if a.status_code==200 and len(a.content)>20000:
                                  with open(out,"wb") as f: f.write(a.content)
                                  log("Music: Pixabay"); return True
                  except: pass
              return False

          def get_bg(sess,out,dur=30,orient="portrait"):
              for q in ["mosque","prayer","islamic","night sky","desert"]:
                  if C["PEX"]:
                      try:
                          r=sess.get("https://api.pexels.com/videos/search",
                              headers={"Authorization":C["PEX"]},
                              params={"query":q,"orientation":orient,"per_page":10},timeout=15)
                          if r.status_code==200:
                              for v in r.json().get("videos",[])[:5]:
                                  ff=v.get("video_files",[])
                                  if not ff: continue
                                  pick=sorted(ff,key=lambda x:abs(x.get("width",0)-1080))[0]
                                  if dl(sess,pick["link"],"tmp_bg.mp4"):
                                      cmd=(f'ffmpeg -y -stream_loop -1 -i tmp_bg.mp4 -t {dur} '
                                           f'-vf "scale=1080:1920:force_original_aspect_ratio=increase,'
                                           f'crop=1080:1920,setsar=1" -an -c:v libx264 -preset veryfast '
                                           f'-crf 23 {out}')
                                      runc(cmd,300); log(f"BG: Pexels/{q}"); return True
                      except: pass
                  if C["PX"]:
                      try:
                          r=sess.get("https://pixabay.com/api/videos/",
                              params={"key":C["PX"],"q":q,"orientation":"vertical","per_page":10},timeout=15)
                          if r.status_code==200:
                              for h in r.json().get("hits",[])[:5]:
                                  for sk in ["medium","small","large"]:
                                      u=h.get("videos",{}).get(sk,{}).get("url")
                                      if not u: continue
                                      if dl(sess,u,"tmp_bg.mp4"):
                                          cmd=(f'ffmpeg -y -stream_loop -1 -i tmp_bg.mp4 -t {dur} '
                                               f'-vf "scale=1080:1920:force_original_aspect_ratio=increase,'
                                               f'crop=1080:1920,setsar=1" -an -c:v libx264 -preset veryfast '
                                               f'-crf 23 {out}')
                                          runc(cmd,300); log(f"BG: Pixabay/{q}"); return True
                      except: pass
              return False

          FONTS={"arabic":["/usr/share/fonts/truetype/noto/NotoNaskhArabic-Bold.ttf"],
                 "devanagari":["/usr/share/fonts/truetype/noto/NotoSansDevanagari-Bold.ttf"],
                 "latin":["/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf",
                          "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"]}
          FC={}
          def fget(sz,script="latin"):
              k=(sz,script)
              if k in FC: return FC[k]
              for p in FONTS.get(script,FONTS["latin"]):
                  if os.path.exists(p):
                      try:
                          f=ImageFont.truetype(p,sz); FC[k]=f; return f
                      except: continue
              f=ImageFont.load_default(); FC[k]=f; return f

          def draw_intro(img,d,t,dur):
              a=min(1.0,t/0.4)
              fa=fget(56,"arabic"); ft=fget(76,"latin"); cc=(230,200,130)
              bb=d.textbbox((0,0),"Bismillah",font=fa); w=bb[2]-bb[0]
              d.text(((1080-w)//2,200),"Bismillah",fill=(cc[0],cc[1],cc[2],int(255*a)),font=fa)
              tp=min(1.0,max(0.0,(t/dur-0.4)/0.4))
              if tp>0:
                  bt=d.textbbox((0,0),"HADITH",font=ft); wt=bt[2]-bt[0]
                  d.text(((1080-wt)//2,980),"HADITH",fill=(cc[0],cc[1],cc[2],int(255*tp)),font=ft)

          def draw_main(img,d,mt,vd,hi,ar,en,lbl,has_logo):
              a=min(1.0,mt/0.5)
              if lbl:
                  f=fget(26,"latin"); bb=d.textbbox((0,0),lbl,font=f); w=bb[2]-bb[0]
                  d.rounded_rectangle([60,180,60+w+32,230],radius=10,
                      fill=(20,15,8,200),outline=(212,175,55,220),width=2)
                  d.text((76,190),lbl,fill=(230,200,130),font=f)
              if has_logo and os.path.exists("avatar.png"):
                  try:
                      lg=Image.open("avatar.png").convert("RGBA").resize((240,100),Image.Resampling.LANCZOS)
                      img.paste(lg,(1080-260,40),lg)
                  except: pass
              CH,CA,CE=(240,130,200),(90,170,255),(255,110,110)
              fh=fget(56,"devanagari"); fa=fget(56,"arabic"); fl=fget(56,"latin")
              def _w(txt,e,td):
                  if not txt: return ""
                  ww=txt.split()
                  if not ww: return ""
                  sp=max(0.45,td/max(len(ww),1)); i=int(e/sp)
                  return ww[max(0,min(i,len(ww)-1))]
              y=780
              ch=_w(hi,mt,vd); cu=_w(ar,mt,vd); ce=_w(en,mt,vd)
              if ch:
                  d.ellipse([130,y+20,170,y+60],fill=(CH[0],CH[1],CH[2],int(255*a)))
                  d.text((190,y),ch,fill=(CH[0],CH[1],CH[2],int(255*a)),font=fh)
              y+=180
              if cu:
                  d.ellipse([130,y+20,170,y+60],fill=(CA[0],CA[1],CA[2],int(255*a)))
                  d.text((190,y),cu,fill=(CA[0],CA[1],CA[2],int(255*a)),font=fa,direction="rtl",language="ar")
              y+=180
              if ce:
                  d.ellipse([130,y+20,170,y+60],fill=(CE[0],CE[1],CE[2],int(255*a)))
                  d.text((190,y),ce,fill=(CE[0],CE[1],CE[2],int(255*a)),font=fl)
              mx=int(1080*0.07); bw=1080-mx*2; by=1920-60
              d.rectangle([mx,by,mx+bw,by+8],fill=(0,0,0,150))
              pw=int(bw*min(1.0,mt/max(vd,1)))
              if pw>0: d.rectangle([mx,by,mx+pw,by+8],fill=(212,175,55,255))

          def draw_outro(img,d,t,dur):
              a=min(1.0,t/0.4); fo=fget(72,"latin")
              bb=d.textbbox((0,0),"JazakAllah Khair",font=fo); w=bb[2]-bb[0]
              d.text(((1080-w)//2,780),"JazakAllah Khair",fill=(230,200,130,int(255*a)),font=fo)

          def master(i,o):
              cmd=f'ffmpeg -y -i "{i}" -af "atempo=0.95,loudnorm=I=-16:TP=-1.5:LRA=11,volume=1.30" "{o}"'
              try:
                  subprocess.run(cmd,shell=True,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=180); return o
              except: shutil.copy(i,o); return o

          def mix(v,m,o,vol=0.18):
              cmd=(f'ffmpeg -y -i "{v}" -i "{m}" '
                   f'-filter_complex "[1:a]volume={vol}[bg];[0:a][bg]amix=inputs=2:duration=first[aout]" '
                   f'-map "[aout]" -c:a libmp3lame -b:a 192k "{o}"')
              subprocess.run(cmd,shell=True,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=180)

          def drive_up(path,prefix="Short"):
              if not os.path.exists(path): return None,None
              try:
                  from google.oauth2.credentials import Credentials
                  from googleapiclient.discovery import build
                  from googleapiclient.http import MediaFileUpload
                  c=Credentials(None,refresh_token=C["GDRT"],client_id=C["GDCID"],client_secret=C["GDCS"],
                      token_uri="https://oauth2.googleapis.com/token")
                  srv=build("drive","v3",credentials=c,cache_discovery=False)
                  meta={"name":f"{prefix}_{int(time.time())}.mp4"}
                  if C["GDF"]: meta["parents"]=[C["GDF"]]
                  media=MediaFileUpload(path,mimetype="video/mp4",resumable=True,chunksize=5*1024*1024)
                  req=srv.files().create(body=meta,media_body=media,fields="id")
                  resp=None
                  while resp is None: _,resp=req.next_chunk()
                  fid=resp.get("id")
                  if not fid: return None,None
                  try: srv.permissions().create(fileId=fid,body={"type":"anyone","role":"reader"}).execute()
                  except: pass
                  log(f"Drive OK: {fid}")
                  return (f"https://drive.google.com/file/d/{fid}/view",
                          f"https://drive.google.com/uc?export=download&id={fid}")
              except Exception as e: log(f"Drive: {str(e)[:100]}","WARN"); return None,None

          def fb_up(path,cap):
              if not (C["FBTOK"] and C["FBPID"]): log("FB skip","WARN"); return False
              try:
                  with open(path,"rb") as f:
                      r=requests.post(f"https://graph.facebook.com/v22.0/{C['FBPID']}/videos",
                          data={"access_token":C["FBTOK"],"description":cap,"published":"true"},
                          files={"source":f},timeout=600).json()
                      if r.get("id"): log(f"FB OK: {r['id']}"); return True
                      log(f"FB FAIL: {str(r.get('error',{}))[:100]}","WARN")
              except Exception as e: log(f"FB: {str(e)[:100]}","WARN")
              return False

          def ig_up(url,cap):
              if not (C["FBTOK"] and C["IGID"] and url): log("IG skip","WARN"); return False
              try:
                  r=requests.post(f"https://graph.facebook.com/v22.0/{C['IGID']}/media",
                      data={"media_type":"REELS","video_url":url,"caption":cap,"access_token":C["FBTOK"]},timeout=60).json()
                  if "error" in r: log(f"IG FAIL: {str(r['error'])[:100]}","WARN"); return False
                  cid=r.get("id")
                  for _ in range(60):
                      time.sleep(10)
                      st=requests.get(f"https://graph.facebook.com/v22.0/{cid}",
                          params={"fields":"status_code","access_token":C["FBTOK"]},timeout=20).json()
                      if st.get("status_code")=="FINISHED": break
                      if st.get("status_code")=="ERROR": return False
                  p=requests.post(f"https://graph.facebook.com/v22.0/{C['IGID']}/media_publish",
                      data={"creation_id":cid,"access_token":C["FBTOK"]},timeout=30).json()
                  if p.get("id"): log(f"IG OK: {p['id']}"); return True
              except Exception as e: log(f"IG: {str(e)[:100]}","WARN")
              return False

          def yt_up(path,title,desc,tags):
              if not (C["YTCID"] and C["YTRT"]): log("YT skip","WARN"); return False
              if not os.path.exists(path): return False
              try:
                  from google.oauth2.credentials import Credentials
                  from googleapiclient.discovery import build
                  from googleapiclient.http import MediaFileUpload
                  c=Credentials(None,refresh_token=C["YTRT"],client_id=C["YTCID"],client_secret=C["YTCS"],
                      token_uri="https://oauth2.googleapis.com/token")
                  yt=build("youtube","v3",credentials=c,cache_discovery=False)
                  body={"snippet":{"title":title[:100],"description":desc,"tags":tags or ["Hadith","Shorts","Islam"],"categoryId":"22"},
                        "status":{"privacyStatus":"public","selfDeclaredMadeForKids":False}}
                  media=MediaFileUpload(path,chunksize=5*1024*1024,resumable=True,mimetype="video/mp4")
                  req=yt.videos().insert(part="snippet,status",body=body,media_body=media)
                  resp=None
                  while resp is None: _,resp=req.next_chunk()
                  vid=resp.get("id")
                  if vid:
                      log(f"YT OK: {vid}")
                      if C["YTPL"]:
                          try:
                              yt.playlistItems().insert(part="snippet",
                                  body={"snippet":{"playlistId":C["YTPL"],
                                      "resourceId":{"kind":"youtube#video","videoId":vid}}}).execute()
                          except: pass
                      return True
              except Exception as e: log(f"YT: {str(e)[:100]}","WARN")
              return False

          def main():
              log("SHORT PIPELINE START")
              sess=new_session()
              tmp=["s_raw.mp3","s_v.mp3","s_voice.mp3","music.mp3","bg.mp4","tmp_bg.mp4","avatar.png"]
              try:
                  h=fetch_hadith(sess,150,400)
                  log(f"Hadith #{h['number']} — {h['collection']}")
                  quran=fetch_quran(sess)
                  hindi=translate(sess,h["english"])
                  if not hindi:
                      hindi=ai_call(sess,f"Is English Hadith ka SHORT punchy Hindi tarjuma (max 60 words):\n\n{h['english']}",250)
                  hindi=hindi or "Amal ka daromadar niyaton par hai."
                  meaning=ai_call(sess,f"Is Hadith ka 1 line Hindi matlab likho:\n\n{hindi}",120) or "Niyat hi amal ki jaan hai."
                  if not tts(sess,f"Hadith Sharif. {hindi} Matlab. {meaning}","s_raw.mp3","hi"):
                      raise Exception("TTS failed")
                  master("s_raw.mp3","s_v.mp3")
                  vd=MP3("s_v.mp3").info.length
                  log(f"Voice: {vd:.1f}s")
                  voice="s_v.mp3"
                  if get_music(sess,"music.mp3",vd+8):
                      mix("s_v.mp3","music.mp3","s_voice.mp3"); voice="s_voice.mp3"
                  if not get_bg(sess,"bg.mp4",vd+3.5,"portrait"): raise Exception("No bg")
                  for c in ["logo.png","assets/logo.png","../logo.png","logo.jpg"]:
                      if os.path.exists(c):
                          try:
                              im=Image.open(c).convert("RGBA")
                              if im.width>400:
                                  rr=400/im.width; im=im.resize((400,int(im.height*rr)),Image.Resampling.LANCZOS)
                              b,bot=12,26; nw,nh=im.width+b*2,im.height+b+bot
                              cv=Image.new("RGBA",(nw,nh),(0,0,0,0)); dd=ImageDraw.Draw(cv)
                              dd.rectangle([0,0,nw-1,nh-1],outline=(212,175,55,255),width=b)
                              cv.paste(im,(b,b),im); cv.save("avatar.png"); break
                          except: continue
                  has_logo=os.path.exists("avatar.png")
                  os.makedirs("s_frames",exist_ok=True)
                  fps,intro,outro=25,1.5,1.5
                  total=intro+vd+outro; n=int(total*fps)
                  log(f"Rendering {n} frames")
                  for fi in range(n):
                      t=fi/fps; img=Image.new("RGBA",(1080,1920),(0,0,0,0)); d=ImageDraw.Draw(img)
                      if t<intro: draw_intro(img,d,t,intro)
                      elif t<intro+vd: draw_main(img,d,t-intro,vd,hindi,h.get("arabic",""),h["english"],
                                                  f"#{h['number']} - {h['collection']}",has_logo)
                      else: draw_outro(img,d,t-(intro+vd),outro)
                      img.save(f"s_frames/frame_{fi:05d}.png")
                  os.makedirs("output/final",exist_ok=True)
                  out="output/final/Final_Short.mp4"
                  cmd=(f'ffmpeg -y -i bg.mp4 -framerate 25 -i s_frames/frame_%05d.png -i {voice} '
                       f'-filter_complex "[0:v][1:v]overlay=0:0:shortest=1,format=yuv420p[outv]" '
                       f'-map "[outv]" -map 2:a -c:v libx264 -preset veryfast -crf 22 '
                       f'-maxrate 8M -bufsize 16M -c:a aac -b:a 192k -t {round(total,2)} '
                       f'-movflags +faststart {out}')
                  runc(cmd,1800)
                  log(f"Video OK: {out}")
                  dl_u,dd_u=drive_up(out,"Short")
                  if SOCIAL:
                      hook=random.choice(["SubhanAllah!","Amazing Hadith","Listen carefully","Must watch","Share this"])
                      tags="#Hadith #Shorts #Islam #Reels #Muslim"
                      cap=f"{hook}\n\nHadith: {hindi}\n\n{meaning}\n\n{quran}\n\n{tags}"
                      fb_up(out,cap)
                      if dd_u: ig_up(dd_u,cap)
                      yt_up(out,f"{h['collection']} #{h['number']} #Shorts",cap,
                            ["Hadith","Shorts","Islam",h["collection"]])
                  log("ALL DONE")
              except Exception as e:
                  log(f"FATAL: {str(e)}","ERROR"); log(traceback.format_exc()[:1500],"ERROR")
              finally:
                  for f in tmp:
                      try:
                          if os.path.exists(f): os.remove(f)
                      except: pass
                  shutil.rmtree("s_frames",ignore_errors=True); report()

          if __name__=="__main__": main()
